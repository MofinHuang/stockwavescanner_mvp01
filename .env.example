# Operational DB; independent from the normalized strategy DB.
SWS_OPS_DB=/opt/StockWaveScanner/var/ops.sqlite3
SWS_PROJECT_DIR=/opt/StockWaveScanner
SWS_TIMEZONE=Asia/Taipei

# Optional mobile dashboard Basic Auth. Set both in production.
SWS_DASHBOARD_USER=owner
SWS_DASHBOARD_PASSWORD=change-me

# Replace these with the project's EXISTING verified entrypoints.
# {as_of_date} is replaced explicitly by the requested trading date.
SWS_STEP_PRICE_CMD=python scripts/sync_prices.py --date {as_of_date}
SWS_STEP_FOREIGN_TWSE_CMD=python scripts/sync_twse_foreign.py --date {as_of_date}
SWS_STEP_FOREIGN_TPEX_CMD=python scripts/sync_tpex_foreign.py --date {as_of_date}
SWS_STEP_TDCC_LATEST_CMD=python scripts/sync_tdcc_latest.py --date {as_of_date}
SWS_STEP_COVERAGE_CMD=python scripts/validate_daily_coverage.py --date {as_of_date}
SWS_STEP_RANKING_CMD=python scripts/build_ranking.py --date {as_of_date}
